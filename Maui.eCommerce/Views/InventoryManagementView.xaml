<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.InventoryManagementView"
             Title="Inventory Management"
             NavigatedTo="ContentPage_NavigatedTo"
             BackgroundColor="Pink">
    
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15">
        <!-- Search Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
            <Entry Text="{Binding Query}" Placeholder="Search products..." Grid.Column="0" TextColor="White" BackgroundColor="RosyBrown"/>
            <Button Text="Search" Grid.Column="1" Clicked="SearchClicked" 
                    Margin="5,0,0,0" WidthRequest="100"
                    BackgroundColor="RosyBrown" TextColor="White"/>
        </Grid>
        
        <!-- Sort Controls -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,15">
            <Label Grid.Column="0" Text="Sort by:" VerticalOptions="Center" FontSize="16" TextColor="White" />
            <Picker Grid.Column="1" SelectedIndex="{Binding SortOption, Mode=TwoWay}" 
                    BackgroundColor="#faa0a0" TextColor="Black" SelectedIndexChanged="SortOptionChanged">
                <Picker.Items>
                    <x:String>Name</x:String>
                    <x:String>Price</x:String>
                    <x:String>Quantity</x:String>
                </Picker.Items>
            </Picker>
        </Grid>
        
        <!-- Product List -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Path=Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" ColumnDefinitions="3*,*,*,Auto,Auto" BackgroundColor="#d8bfbf">
                            <Label Grid.Column="0" Text="{Binding Product.Name}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding Product.Price, StringFormat='${0:F2}'}" TextColor="Green" />
                            <Label Grid.Column="2" Text="{Binding Quantity, StringFormat='Qty: {0}'}" />
                            <Button Grid.Column="3" Text="Edit" Clicked="ItemEditClicked" 
                                    VerticalOptions="Center" BackgroundColor="#c99999" CommandParameter="{Binding Id}" />
                            <Button Grid.Column="4" Text="Delete" Clicked="ItemDeleteClicked" 
                                    VerticalOptions="Center" BackgroundColor="#b88b8b" TextColor="White"
                                    CommandParameter="{Binding Id}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!-- Action Buttons -->
        <VerticalStackLayout Grid.Row="3" Spacing="10" Margin="0,15,0,0">
            <Button Text="Add New Product" Clicked="AddClicked" 
                    BackgroundColor="#b88b8b" TextColor="White" />
            <Button Text="Go to Shopping Cart" Clicked="GoToShoppingClicked" 
                    BackgroundColor="#b88b8b" TextColor="White" />
            <Button Text="Go Back" Clicked="CancelClicked" 
                    BackgroundColor="#b88b8b" TextColor="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>