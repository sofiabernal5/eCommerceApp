<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.CartManagementView">

    <ContentPage.BindingContext>
        <viewModels:CartViewModel xmlns:viewModels="clr-namespace:Maui.eCommerce.ViewModels" />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20">
        <Label Text="{Binding Display}" FontSize="24" HorizontalOptions="Center" VerticalOptions="CenterAndExpand" />
        <Button 
            Text="Go Back" 
            Clicked="GoBackClicked" 
            HorizontalOptions="Center"
        />
    </VerticalStackLayout>
</ContentPage>