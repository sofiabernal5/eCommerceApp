<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.ShoppingManagementView"
             Title="ShoppingManagementView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><!-- STORE -->
            <ColumnDefinition Width="*" /><!-- USER SHOPPING CART -->
        </Grid.ColumnDefinitions>

        <!-- STORE SECTION -->
        <VerticalStackLayout Grid.Column="0" Spacing="10" Padding="10">
            <ListView 
                ItemsSource="{Binding Inventory}"
                SelectedItem="{Binding SelectedItem}"
                HeightRequest="400"
            />
            <Button 
                Text="Add to Cart" 
                Clicked="AddToCartClicked" 
                HorizontalOptions="Center"
            />
        </VerticalStackLayout>

        <!-- USER SHOPPING CART SECTION -->
        <VerticalStackLayout Grid.Column="1" Spacing="10" Padding="10">
            <Label Text="Shopping Cart" FontSize="Medium" FontAttributes="Bold"/>
            <ListView 
                ItemsSource="{Binding CartItems}"
                SelectedItem="{Binding SelectedItem}"
                HeightRequest="400"
            />
            <Button 
                Text="Go Back" 
                Clicked="GoBackClicked" 
                HorizontalOptions="Center"
            />
        </VerticalStackLayout>
    </Grid>
</ContentPage>